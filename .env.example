# ─────────────────────────────────────────────────────────────────────────────
# Shringaar — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# IMPORTANT — what is safe in a frontend bundle:
#   VITE_SUPABASE_URL       safe. Public endpoint of your project.
#   VITE_SUPABASE_ANON_KEY  safe ONLY because Supabase protects rows with RLS.
#                           The anon key is a public identifier, not a secret.
#   SUPABASE_SERVICE_ROLE_KEY  **NEVER** put this in a VITE_ variable. Anything
#                           prefixed VITE_ is inlined into the shipped JS. The
#                           service-role key bypasses RLS entirely and must only
#                           ever exist in a server/runtime or edge function.
#
# When these are absent the dashboard runs in **demo mode**: the service layer
# falls back to an in-browser store and every metric is labelled as demo data.
# ─────────────────────────────────────────────────────────────────────────────

# Public AR try-on experience host, used to build the try-on link on a product.
# Example: https://try.shringaar.app
VITE_TRYON_BASE_URL=

# Base URL of the asset-processing service (see backend/README.md).
# Example: https://shringaar-virtual-try-on.onrender.com (or http://localhost:8000 for local dev)
# Leave blank when that service is not running: the dashboard then offers no
# photo-to-transparent-cutout processing, and every existing upload path still works.
VITE_ASSET_API_URL=

# Public site origin, used to build shareable storefront/product links.
# Defaults to window.location.origin when unset.
VITE_PUBLIC_SITE_URL=

# Supabase (leave blank until a project exists — see docs/arch.md §7)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
