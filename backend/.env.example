# Shringaar asset backend — environment template.
# Copy to `.env` and adjust. Every value has a working default, so an empty file is valid.

# Which provider implementations the pipeline uses.
#   baseline — real, deterministic, NON-ML image processing (background key + connected
#              components). Produces a genuine transparent PNG. Not a trained model.
#   mock     — pure simulation. Returns fixed synthetic results, writes NO real cutout.
# See app/providers/__init__.py. `baseline` is the default because it makes the
# upload-to-review workflow genuinely produce a transparent asset.
ASSET_PROVIDER=baseline

# Upload guards
ASSET_MAX_UPLOAD_BYTES=12582912
ASSET_MAX_IMAGE_PIXELS=50000000

# Generated 2D asset long-edge, in pixels
ASSET_OUTPUT_LONG_EDGE=1024

# 3D generation. No real model is wired up in this milestone; this flag does not make one exist.
ASSET_ENABLE_3D=false

# Local storage root. Relative paths resolve against backend/.
ASSET_DATA_DIR=data

# Comma-separated origins allowed to call this API from a browser.
ASSET_CORS_ORIGINS=http://localhost:5173,http://localhost:5199,http://127.0.0.1:5173,http://127.0.0.1:5199

# Public base URL this service is reachable at, used to build asset URLs returned to the client.
ASSET_PUBLIC_BASE_URL=http://localhost:8000
